# Local Python startup; Docker Compose supplies DB_HOST=db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twitter_db
DB_USER=postgres
DB_PASSWORD=postgres
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_UPLOAD_BYTES=5242880
MEDIA_DIR=static/media
SEED_DEMO=false
# Optional published Compose ports:
BACKEND_PORT=8000
FRONTEND_PORT=3000
